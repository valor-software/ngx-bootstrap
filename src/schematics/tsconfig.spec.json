{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"]
  },
  // Clear the base tsconfig's `exclude: ["./src/**/*.spec.ts"]`, which would
  // otherwise cancel out every path in `include` and leave zero inputs (TS18003).
  "exclude": [],
  "include": [
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.js",
    "**/*.spec.jsx",
    "**/*.d.ts"
  ]
}
