{
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "jest"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "jest",
      "strict": true
    },
    "@nx/angular:component": {
      "style": "scss"
    },
    "@nx/angular": {
      "application": {
        "linter": "eslint"
      },
      "library": {
        "linter": "eslint"
      },
      "storybook-configuration": {
        "linter": "eslint"
      }
    }
  },
  "defaultProject": "ngx-bootstrap-docs",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/angular.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tslint.json",
      "{workspaceRoot}/nx.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/src/test-setup.[jt]s"
    ]
  },
  "targetDefaults": {
    "build": {
      "inputs": ["production", "^production"]
    },
    "e2e": {
      "inputs": ["default", "^production"]
    },
    "@nx/jest:jest": {
      "inputs": ["default", "^production", "{workspaceRoot}/jest.preset.js"],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  },
  "useInferencePlugins": false,
  "defaultBase": "development",
  "nxCloudAccessToken": "ZjAyZjFlMDUtNTY4Zi00ZmUzLWEyMjUtNzdmYjFiMGRkM2VlfHJlYWQtd3JpdGU=",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/ngx-bootstrap-docs/**/*",
        "apps/ngx-bootstrap-docs-e2e/**/*",
        "libs/common-docs/**/*",
        "libs/doc-pages/accordion/**/*",
        "libs/doc-pages/alerts/**/*",
        "libs/doc-pages/buttons/**/*",
        "libs/doc-pages/carousel/**/*",
        "libs/doc-pages/collapse/**/*",
        "libs/doc-pages/datepicker/**/*",
        "libs/doc-pages/dropdown/**/*",
        "libs/doc-pages/modal/**/*",
        "libs/doc-pages/pagination/**/*",
        "libs/doc-pages/popover/**/*",
        "libs/doc-pages/progressbar/**/*",
        "libs/doc-pages/rating/**/*",
        "libs/doc-pages/sortable/**/*",
        "libs/doc-pages/tabs/**/*",
        "libs/doc-pages/timepicker/**/*",
        "libs/doc-pages/tooltip/**/*",
        "libs/doc-pages/typeahead/**/*",
        "src/accordion/**/*",
        "src/alert/**/*",
        "src/buttons/**/*",
        "src/carousel/**/*",
        "src/chronos/**/*",
        "src/collapse/**/*",
        "src/component-loader/**/*",
        "src/datepicker/**/*",
        "src/dropdown/**/*",
        "src/focus-trap/**/*",
        "src/locale/**/*",
        "src/mini-ngrx/**/*",
        "src/modal/**/*",
        "src/pagination/**/*",
        "src/popover/**/*",
        "src/positioning/**/*",
        "src/progressbar/**/*",
        "src/rating/**/*",
        "src/root/**/*",
        "src/schematics/src/**/*",
        "src/sortable/**/*",
        "src/tabs/**/*",
        "src/timepicker/**/*",
        "src/tooltip/**/*",
        "src/typeahead/**/*",
        "src/utils/**/*"
      ]
    }
  ]
}
