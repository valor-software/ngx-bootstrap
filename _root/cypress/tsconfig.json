{
  "compilerOptions": {
    "declaration": false,
    "sourceMap": true,
    "noEmitHelpers": false,
    "moduleResolution": "node",
    "typeRoots": ["../node_modules/@types"],
    "lib": ["es2017", "dom"],
    "ignoreDeprecations": "6.0",
    "strict": false,
    "noUncheckedSideEffectImports": false
  },
  "include": [
    "integration/*.ts",
    "snapshot/*.ts",
    "full/*.ts",
    "full/**/*.ts",
    "support/*.ts",
    "../node_modules/cypress"
  ]
}
